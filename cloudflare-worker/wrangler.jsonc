{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elo-push",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "vars": {
    "FIREBASE_PROJECT_ID": "elo-app-82e6e",
    "ALLOWED_ORIGIN": "*"
  },
  "r2_buckets": [
    {
      "binding": "ELO_MEDIA",
      "bucket_name": "elo-chat-media"
    }
  ]
}
