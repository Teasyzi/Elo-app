{
  "private": true,
  "scripts": {
    "dev:css": "tailwindcss -i ./tailwind-input.css -o ./tailwind.css --watch",
    "build:css": "tailwindcss -i ./tailwind-input.css -o ./tailwind.css --minify",
    "prepare:android:web": "npm run build:css && node ./scripts/prepare-capacitor.mjs",
    "android:add": "npm run prepare:android:web && npx cap add android",
    "android:sync": "npm run prepare:android:web && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android"
  },
  "devDependencies": {
    "tailwindcss": "4.1.10",
    "@tailwindcss/cli": "4.1.10",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.0"
  }
}
